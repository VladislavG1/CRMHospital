model FileStorageDocs {
  id           String   @id @default(uuid()) @db.Uuid


  originalName String?   @db.VarChar

  storageName  String?   @db.VarChar

  mimeType     String?   @db.VarChar
  size         BigInt?
  



  uploadedById String?   @db.Uuid
  uploadedAt   DateTime @default(now())


  documents          Documents[]
  filledTemplateDocs FilledTemplateDocuments[]

  @@map("filestoragedocs")
}

model DocumentStatus {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?  @db.Text
  dataCreate  DateTime @default(now())

  documents          Documents[]
  filledTemplateDocs FilledTemplateDocuments[]

  @@map("documentstatus")
}

model DocumentsTypes {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?  @db.Text
  dataCreate  DateTime @default(now())

  documents          Documents[]
  TemplateDocuments  TemplateDocuments[]
  constDocuments     ConstDocuments[]
  filledTemplateDocs FilledTemplateDocuments[]

  @@map("documetnstypes")
}

