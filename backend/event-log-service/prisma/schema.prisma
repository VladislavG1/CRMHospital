generator client {
  provider = "prisma-client-js"
  schema   = "event_log"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model LogsActions {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  microservice String   @db.VarChar(64)
  action       String   @db.VarChar(128)
  payload      Json?
  ip_address   String?  @db.VarChar(45)
  date_create  DateTime @default(now())

  @@index([user_id])
  @@index([microservice])
  @@index([date_create])
  @@map("logs_actions")
}

model ErrorLogs {
  id           String        @id @default(uuid()) @db.Uuid
  microservice String        @db.VarChar(64)
  message      String        @db.Text
  stack_trace  String?       @db.Text
  severity     ErrorSeverity @default(MEDIUM)
  context      Json?
  date_create  DateTime      @default(now())

  @@index([microservice])
  @@index([severity])
  @@index([date_create])
  @@map("error_logs")
}
