generator client {
  provider = "prisma-client-js"
  schema   = "event-log"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventsLog {
  id           String   @id @default(uuid())
  event_type   String
  event_name   String
  service_name String
  entity_type  String
  entity_id    String
  user_id      String
  ip_address   String?
  created_at   DateTime @default(now())

  @@index([event_type])
  @@index([entity_type])
  @@index([entity_id])
  @@index([user_id])
  @@index([created_at])
  @@index([service_name])

}

model UserDocumentPreference {
  id          String   @id @default(uuid())
  userId      String
  documentId  String
  hidden      Boolean  @default(false)
  pinned      Boolean  @default(false)
  pinnedOrder Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([userId, documentId])
  @@index([userId])
  @@map("user_document_preferences")

}